{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/article.mjs": {
      "includeFiles": "**/*.js"
    },
    "api/article-final.mjs": {
      "includeFiles": "**/*.js"
    },
    "api/articles.mjs": {
      "includeFiles": "**/*.js"
    }
  },
  "redirects": [
    {"source":"/faq","destination":"/#faq","permanent":true},
    {"source":"/faq/:path*","destination":"/#faq","permanent":true},
    {"source":"/statti/lin-chy-vtoma/","destination":"/statti/prychyny-lini/","permanent":true},
    {"source":"/statti/yak-povernuty-interes-do-sprav/","destination":"/statti/nichogo-ne-raduie-yak-povernuty-interes-do-zhyttia/","permanent":true}
  ],
  "rewrites": [
    {"source":"/lin/","destination":"/api/articles?category=lin"},
    {"source":"/apatiia/","destination":"/api/articles?category=apatiia"},
    {"source":"/prokrastynatsiia/","destination":"/api/articles?category=prokrastynatsiia"},
    {"source":"/statti/","destination":"/api/articles"},
    {"source":"/statti/:slug/","destination":"/api/article-final?slug=:slug"}
  ]
}

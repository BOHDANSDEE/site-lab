{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/article.mjs": {
      "includeFiles": "**/*.js"
    },
    "api/article-final.mjs": {
      "includeFiles": "**/*.js"
    },
    "api/articles.mjs": {
      "includeFiles": "**/*.js"
    }
  },
  "redirects": [

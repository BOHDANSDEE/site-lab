    {"source":"/statti/lin-chy-vtoma/","destination":"/statti/prychyny-lini/","permanent":true},
    {"source":"/statti/chomu-vazhko-pochaty-prostu-spravu/","destination":"/statti/lin-chy-vyhorannia/","permanent":true},
    {"source":"/statti/yak-povernutysia-do-sprav-pislia-perervy/","destination":"/statti/yak-zmusyty-sebe-vchytysia/","permanent":true},
    {"source":"/statti/lin-i-son/","destination":"/statti/yak-zmusyty-sebe-prybyraty/","permanent":true},
    {"source":"/statti/yak-rozbyty-velyke-zavdannia/","destination":"/statti/lin-u-pidlitkiv/","permanent":true},
    {"source":"/statti/koly-vse-zdaietsia-zanadto-skladnym/","destination":"/statti/yak-vstaty-z-lizhka-vrantsi/","permanent":true},

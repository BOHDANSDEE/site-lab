    {"source":"/statti/dedlainy-bez-nichnoho-avralu/","destination":"/statti/chomu-vse-roblu-v-ostanniu-myt/","permanent":true},
    {"source":"/statti/metod-desiaty-khvylyn/","destination":"/statti/metod-pomodoro/","permanent":true},
    {"source":"/statti/yak-planuvaty-den-pry-prokrastynatsii/","destination":"/statti/chomu-vse-roblu-v-ostanniu-myt/","permanent":true},
